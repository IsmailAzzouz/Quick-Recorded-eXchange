{
  "name": "qrx-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../crate --target web --release -- --locked",
    "dev": "vite --host 0.0.0.0",
    "build": "npm run build:wasm && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "serve": "node scripts/serve.mjs",
    "test": "node --test unit/*.test.js && playwright test"
  },
  "dependencies": {
    "jsqr": "1.4.0",
    "nosleep.js": "0.12.0",
    "webm-writer": "1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^2.0.0"
  }
}
